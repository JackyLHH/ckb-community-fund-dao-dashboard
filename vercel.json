{
  "framework": null,
  "cleanUrls": true,
  "buildCommand": "npm run build",
  "outputDirectory": "dist/client",
  "installCommand": "npm install",
  "functions": {
    "api/subscription.ts": {
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/digest",
      "schedule": "0 8 * * *"
    }
  ],
  "rewrites": [
    {
      "source": "/api/subscribe",
      "destination": "/api/subscription?action=subscribe"
    },
    {
      "source": "/api/confirm",
      "destination": "/api/subscription?action=confirm"
    },
    {
      "source": "/api/unsubscribe",
      "destination": "/api/subscription?action=unsubscribe"
    },
    {
      "source": "/api/webhooks/resend",
      "destination": "/api/subscription?action=resend-webhook"
    },
    {
      "source": "/api/cron/digest",
      "destination": "/api/subscription?action=digest"
    },
    {
      "source": "/live/nervos/category",
      "destination": "https://talk.nervos.org/c/daos-funding/ckb-community-fund-dao/65.json"
    },
    {
      "source": "/live/nervos/topic/:id",
      "destination": "https://talk.nervos.org/t/:id.json"
    },
    {
      "source": "/live/ckb/dao-balance",
      "destination": "https://mainnet-api.explorer.nervos.org/api/v1/addresses/ckb1qyqnrg4jfx82g29l44q6d93jnrm5ytcp0d8sjfev2q"
    }
  ],
  "headers": [
    {
      "source": "/live/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, s-maxage=900, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
